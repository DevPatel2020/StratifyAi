# Copy this file to .env and fill in your own keys. .env is git-ignored.
# All providers are optional; StratifyAI uses whichever are configured, in the order set in Settings.

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama (local, offline) - https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_FAST_MODEL=llama3.2

# Python AI service (classifier, RAG, tools)
AI_SERVICE_PORT=8765
# chroma = built-in ONNX MiniLM embeddings (no extra install); ollama = nomic-embed-text via Ollama
EMBEDDINGS=chroma
