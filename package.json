{
  "name": "stratifyai",
  "version": "2.0.0",
  "description": "StratifyAI - AI strategic thinking assistant with guided thinking paths, multi-provider LLM routing (Groq, Gemini, Ollama), document RAG, agent tools and evaluation.",
  "main": "./out/main/index.js",
  "author": "Dev Patel",
  "license": "MIT",
  "homepage": "https://github.com/DevPatel2020/StratifyAi",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ai:setup": "node scripts/setup-ai-service.mjs",
    "ai:train": "node scripts/run-python.mjs scripts/train_classifier.py",
    "ai:eval": "node scripts/run-python.mjs eval/run_eval.py --limit 10"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "dotenv": "^16.4.5",
    "marked": "^14.1.3",
    "openai": "^4.73.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/sql.js": "^1.4.9",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xyflow/react": "^12.3.5",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "highlight.js": "^11.10.0",
    "jsdom": "^25.0.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "io.github.devpatel2020.stratifyai",
    "productName": "StratifyAI",
    "directories": { "output": "release", "buildResources": "resources" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      { "from": "ai-service", "to": "ai-service", "filter": ["**/*", "!.venv/**", "!**/__pycache__/**", "!chroma/**"] }
    ],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
